<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- Deep link do Modo Guardião: com.statusads.connect://sos
                 (atalho no ícone + tile de atalhos rápidos) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>
            <!-- Atalho estático "SOS Agora" no launcher -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- ══ CAMUFLAGEM DO LAUNCHER (v3.9.0) ═════════════════════════
             O ícone/nome real vive num alias; os disfarces são aliases com
             ícone+label próprios. Apenas UM alias está activo de cada vez —
             trocado em runtime via PackageManager.setComponentEnabledSetting
             (DisguisePlugin). A activity em si nunca é desactivada, por isso
             deep links, atalhos e tile continuam a funcionar disfarçados. -->
        <activity-alias
            android:name=".LauncherReal"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCalculadora"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_disg_calc"
            android:label="@string/disg_calc"
            android:roundIcon="@drawable/ic_disg_calc"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherMeteorologia"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_disg_weather"
            android:label="@string/disg_weather"
            android:roundIcon="@drawable/ic_disg_weather"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNotas"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_disg_notes"
            android:label="@string/disg_notes"
            android:roundIcon="@drawable/ic_disg_notes"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherRelogio"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_disg_clock"
            android:label="@string/disg_clock"
            android:roundIcon="@drawable/ic_disg_clock"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherContactos"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_disg_contacts"
            android:label="@string/disg_contacts"
            android:roundIcon="@drawable/ic_disg_contacts"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherMusica"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_disg_music"
            android:label="@string/disg_music"
            android:roundIcon="@drawable/ic_disg_music"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Modo Guardião: sentinela 24/7 — Power ×4 + agitação + registo de
             testemunhas BLE mesmo com a app fechada -->
        <service
            android:name=".GuardianService"
            android:exported="false"
            android:foregroundServiceType="specialUse|connectedDevice">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Sentinela de pânico: detecta gatilhos de emergência (padrão do botão power, agitação forte) para avisar contactos de emergência em caso de roubo ou sequestro" />
        </service>

        <!-- Modo Guardião: religa a sentinela após reinício/actualização da app -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Modo Guardião: tile "SOS" nos atalhos rápidos do Android -->
        <service
            android:name=".SosTileService"
            android:icon="@drawable/ic_sos_shortcut"
            android:label="@string/tile_sos_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Localizacao (SOS, rastreio de viagem, geofences) — adicionadas tambem
         pelo plugin @capacitor/geolocation via merge de manifest -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Evidencias: gravacao de audio e camera (MediaRecorder no WebView) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Deteccao de queda (acelerometro de alta frequencia no Android 12+) -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- Vibracao/haptics (SOS, chamada falsa, deteccao de queda) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Notificacoes locais (lembretes de check-in, alertas) — Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Manter CPU activo durante emergencia / Dead Man's Switch -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Modo Guardião: sentinela 24/7 (serviço foreground + sobrevive a reinícios) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- SOS com o ecrã apagado: abrir por cima do ecrã de bloqueio (padrão alarme) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Impedir OEMs (Xiaomi/Samsung) de adormecer a sentinela -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Registo de testemunhas: scan BLE pela sentinela (MAC nunca sai do
         aparelho em claro — apenas hash). neverForLocation: sem GPS a partir
         do BLE; em Android <12 é exigida localização para scan → FINE maxSdk 30 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Android <12: scan BLE exige localização — ACCESS_FINE_LOCATION já declarada acima -->
    <!-- Scan BLE a partir do serviço foreground (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
</manifest>
