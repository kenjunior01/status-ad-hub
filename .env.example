# ============================================
# StatusAds Connect — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# Generate with:  cp .env.example .env.local
# ============================================

# ============================================
# SUPABASE (required)
# ============================================
# Get these from: https://app.supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# WEB PUSH (optional — for background notifications)
# ============================================
# Generate VAPID keys:  npx web-push generate-vapid-keys
# Set ONLY the public key here. Private key goes in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=

# ============================================
# TWILIO SMS (optional — for SMS notifications to emergency contacts)
# ============================================
# These go in Supabase Dashboard → Edge Functions → Secrets (NOT here)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+15551234567

# ============================================
# EDGE FUNCTION SECRETS (set in Supabase Dashboard, not here)
# ============================================
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@statusmonetize.com
# SUPABASE_URL=https://your-project.supabase.co  (auto-provided)
# SUPABASE_SERVICE_ROLE_KEY=  (auto-provided)

# ============================================
# DATABASE SETTINGS (set via SQL, not env)
# ============================================
# For pg_net auto-notification trigger, run in Supabase SQL Editor:
#   SET app.supabase_url = 'https://your-project.supabase.co';
#   SET app.service_role_key = 'your-service-role-key';
